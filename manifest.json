{
  "manifest_version": 3,
  "name": "GroupNap",
  "version": "1.0.0",
  "description": "Collapse a tab group, free RAM instantly. Tabs nap until you need them.",
  "permissions": ["tabGroups", "tabs", "storage"],
  "action": {
    "default_title": "GroupNap — Stats",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
